# Sabe - Environment Variables

# Search API (Serper) — keyword-based Google search
VITE_SERPER_API_KEY=your_serper_api_key_here

# Search API (Exa) — semantic/neural search, better for supplier discovery
# Get key at: https://dashboard.exa.ai/
VITE_EXA_API_KEY=your_exa_api_key_here

# Optional: Analytics
VITE_ANALYTICS_ID=
